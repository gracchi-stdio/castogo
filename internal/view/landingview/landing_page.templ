package landingview

import (
	"fmt"
	"strings"

	"github.com/gracchi-stdio/castogo/internal/domain"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
	"github.com/gracchi-stdio/castogo/internal/view/components/icon"
	"github.com/gracchi-stdio/castogo/internal/view/layout"
)

templ LandingPage(data *domain.LandingPageData) {
	@layout.BaseLayout() {
		<!-- Navigation -->
		<nav class="sticky top-0 z-50 border-b bg-background/80 backdrop-blur">
			<div class="mx-auto max-w-6xl flex items-center justify-between px-6 py-4">
				<a href="/" class="text-xl font-bold text-foreground">Podlog</a>
				<div class="flex items-center gap-4">
					<a href="/login" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Sign in</a>
					if data.CTA != nil && data.CTA.ButtonURL != "" {
						@button.Button(button.ButtonArgs{
							Size: "sm",
							Attributes: map[string]any{
								"onclick": fmt.Sprintf("window.location.href='%s'", data.CTA.ButtonURL),
							},
						}) {
							{ data.CTA.ButtonText }
						}
					}
				</div>
			</div>
		</nav>
		for _, key := range data.SectionOrder {
			switch key {
			case "hero":
				if data.Hero != nil {
					@heroSection(data.Hero)
				}
			case "features":
				if data.Features != nil {
					@featuresSection(data.Features)
				}
			case "episodes_showcase":
				@episodesSection(data)
			case "testimonials":
				if data.Testimonials != nil {
					@testimonialsSection(data.Testimonials)
				}
			case "cta":
				if data.CTA != nil {
					@ctaSection(data.CTA)
				}
			case "footer":
				if data.Footer != nil {
					@footerSection(data.Footer)
				}
			}
		}
		// Minimal footer fallback if no footer section
		if data.Footer == nil {
			<footer class="border-t py-6 text-center text-sm text-muted-foreground">
				<p>2026 Podlog. All rights reserved.</p>
			</footer>
		}
	}
}

templ heroSection(hero *domain.HeroContent) {
	<section class="relative overflow-hidden">
		if hero.BackgroundImage != "" {
			<div class="absolute inset-0 bg-cover bg-center" style={ fmt.Sprintf("background-image: url('%s')", hero.BackgroundImage) }>
				<div class="absolute inset-0 bg-black/50"></div>
			</div>
		}
		<div class={ "relative mx-auto max-w-4xl px-6 py-24 text-center", ternary(hero.BackgroundImage == "", "bg-gradient-to-br from-primary/5 via-background to-primary/10", "") }>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground">
				{ hero.Headline }
			</h1>
			if hero.Subheadline != "" {
				<p class="mt-6 text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto">
					{ hero.Subheadline }
				</p>
			}
			if hero.CTAText != "" {
				<div class="mt-10">
					@button.Button(button.ButtonArgs{
						Size: "lg",
						Class: "text-base px-8",
						Attributes: map[string]any{
							"onclick": fmt.Sprintf("window.location.href='%s'", hero.CTAURL),
						},
					}) {
						{ hero.CTAText }
					}
				</div>
			}
		</div>
	</section>
}

templ featuresSection(features *domain.FeaturesContent) {
	<section class="py-20 bg-muted/30">
		<div class="mx-auto max-w-6xl px-6">
			<div class="text-center mb-12">
				if features.SectionTitle != "" {
					<h2 class="text-3xl font-bold text-foreground">{ features.SectionTitle }</h2>
				}
				if features.SectionDescription != "" {
					<p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">{ features.SectionDescription }</p>
				}
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
				for _, item := range features.Items {
					@featureCard(item)
				}
			</div>
		</div>
	</section>
}

templ featureCard(item domain.FeatureItem) {
	<div class="rounded-xl border bg-background p-6 hover:shadow-md transition-shadow">
		if item.Icon != "" {
			<div class="mb-4 text-primary">
				@icon.Lucide(item.Icon, "size-8")
			</div>
		}
		<h3 class="text-lg font-semibold text-foreground">{ item.Title }</h3>
		if item.Description != "" {
			<p class="mt-2 text-sm text-muted-foreground leading-relaxed">{ item.Description }</p>
		}
	</div>
}

templ episodesSection(data *domain.LandingPageData) {
	if data.EpisodesShowcase == nil {
		return
	}
	<section id="episodes" class="py-20">
		<div class="mx-auto max-w-6xl px-6">
			<div class="text-center mb-12">
				if data.EpisodesShowcase.SectionTitle != "" {
					<h2 class="text-3xl font-bold text-foreground">{ data.EpisodesShowcase.SectionTitle }</h2>
				}
				if data.EpisodesShowcase.SectionDescription != "" {
					<p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">{ data.EpisodesShowcase.SectionDescription }</p>
				}
			</div>
			if len(data.LatestEpisodes) > 0 {
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
					for _, ep := range data.LatestEpisodes {
						@episodeCard(ep)
					}
				</div>
			} else {
				<div class="text-center py-12 rounded-xl border border-dashed">
					<p class="text-muted-foreground">No episodes yet. Check back soon!</p>
				</div>
			}
		</div>
	</section>
}

templ episodeCard(ep *domain.Episode) {
	<div class="rounded-xl border overflow-hidden hover:shadow-md transition-shadow">
		<div class="aspect-video bg-muted flex items-center justify-center">
			if ep.CoverImageURL != "" {
				<img src={ ep.CoverImageURL } alt={ ep.Title } class="w-full h-full object-cover"/>
			} else {
				@icon.Lucide("mic", "size-12 text-muted-foreground/50")
			}
		</div>
		<div class="p-4">
			<p class="text-xs text-muted-foreground mb-1">Episode { fmt.Sprintf("%d", ep.EpisodeNumber) }</p>
			<h3 class="font-semibold text-foreground line-clamp-2">{ ep.Title }</h3>
			if ep.Description != "" {
				<p class="mt-2 text-sm text-muted-foreground line-clamp-2">{ ep.Description }</p>
			}
			if ep.Duration > 0 {
				<p class="mt-3 text-xs text-muted-foreground">{ formatDuration(ep.Duration) }</p>
			}
		</div>
	</div>
}

templ testimonialsSection(testimonials *domain.TestimonialsContent) {
	<section class="py-20 bg-muted/30">
		<div class="mx-auto max-w-6xl px-6">
			<div class="text-center mb-12">
				if testimonials.SectionTitle != "" {
					<h2 class="text-3xl font-bold text-foreground">{ testimonials.SectionTitle }</h2>
				}
				if testimonials.SectionDescription != "" {
					<p class="mt-4 text-lg text-muted-foreground max-w-2xl mx-auto">{ testimonials.SectionDescription }</p>
				}
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				for _, item := range testimonials.Items {
					@testimonialCard(item)
				}
			</div>
		</div>
	</section>
}

templ testimonialCard(item domain.TestimonialItem) {
	<div class="rounded-xl border bg-background p-6">
		<p class="text-foreground leading-relaxed italic">"{ item.Quote }"</p>
		<div class="mt-4 flex items-center gap-3">
			if item.AvatarURL != "" {
				<img src={ item.AvatarURL } alt={ item.Author } class="w-10 h-10 rounded-full object-cover"/>
			} else {
				<div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-sm font-medium text-primary">
					{ strings.ToUpper(string(item.Author[0])) }
				</div>
			}
			<div>
				<p class="text-sm font-medium text-foreground">{ item.Author }</p>
				if item.Role != "" {
					<p class="text-xs text-muted-foreground">{ item.Role }</p>
				}
			</div>
		</div>
	</div>
}

templ ctaSection(cta *domain.CTAContent) {
	<section class="py-20">
		<div class="mx-auto max-w-4xl px-6">
			<div class="rounded-2xl bg-primary/5 border border-primary/10 p-12 text-center">
				if cta.Headline != "" {
					<h2 class="text-3xl font-bold text-foreground">{ cta.Headline }</h2>
				}
				if cta.Description != "" {
					<p class="mt-4 text-lg text-muted-foreground max-w-xl mx-auto">{ cta.Description }</p>
				}
				if cta.ButtonText != "" {
					<div class="mt-8">
						@button.Button(button.ButtonArgs{
							Size: "lg",
							Class: "text-base px-8",
							Attributes: map[string]any{
								"onclick": fmt.Sprintf("window.location.href='%s'", cta.ButtonURL),
							},
						}) {
							{ cta.ButtonText }
						}
					</div>
				}
			</div>
		</div>
	</section>
}

templ footerSection(footer *domain.FooterContent) {
	<footer class="border-t py-12 bg-muted/30">
		<div class="mx-auto max-w-6xl px-6">
			<div class="flex flex-col sm:flex-row items-center justify-between gap-6">
				<p class="text-sm text-muted-foreground">{ footer.Copyright }</p>
				if len(footer.Links) > 0 {
					<div class="flex items-center gap-6">
						for _, link := range footer.Links {
							<a href={ templ.SafeURL(link.URL) } class="text-sm text-muted-foreground hover:text-foreground transition-colors">{ link.Label }</a>
						}
					</div>
				}
				if len(footer.SocialLinks) > 0 {
					<div class="flex items-center gap-4">
						for _, social := range footer.SocialLinks {
							<a href={ templ.SafeURL(social.URL) } class="text-muted-foreground hover:text-foreground transition-colors" aria-label={ social.Platform }>
								@icon.Lucide(socialPlatformIcon(social.Platform), "size-5")
							</a>
						}
					</div>
				}
			</div>
		</div>
	</footer>
}
