package layout

import (
	"github.com/gracchi-stdio/castogo/internal/config"
	"github.com/gracchi-stdio/castogo/internal/view/components/icon"
	"github.com/gracchi-stdio/castogo/internal/view/components/sheet"
)

type PublicNavbarData struct {
	CTAhref  string
	CTAtext  string
	NavLinks []NavLink
}

type NavLink struct {
	Label string
	URL   string
}

templ PublicNavbar(data *PublicNavbarData) {
	<nav class="public-nav sticky top-0 z-50 bg-background border-b-2 border-border">
		<!-- Row 1: Brand + Search (desktop) -->
		<div class="public-nav-row1 mx-auto max-w-6xl flex items-center justify-between px-6 py-3">
			<a href="/" class="text-xl font-bold text-foreground font-heading">{ config.Cfg.AppName }</a>

			<!-- Desktop search -->
			<form action="/search" method="GET" data-public-search class="hidden md:flex items-center">
				<div class="flex border-2 border-border">
					<input
						type="text"
						name="q"
						placeholder="SEARCH..."
						class="public-search-input border-none w-48"
						autocomplete="off"
					/>
					<button type="submit" class="px-3 text-muted-foreground hover:text-foreground transition-colors cursor-pointer">
						@icon.Lucide("search", "size-4")
					</button>
				</div>
			</form>

			<!-- Mobile hamburger -->
			@sheet.SheetTrigger(sheet.SheetTriggerArgs{
				SheetID: "mobile-nav-sheet",
				AsChild: true,
				Class:   "md:hidden p-2 text-foreground cursor-pointer",
			}) {
				@icon.Lucide("menu", "size-6")
			}
		</div>

		<!-- Row 2: Nav links (desktop) -->
		if len(data.NavLinks) > 0 {
			<div class="public-nav-row2 border-t border-border">
				<div class="mx-auto max-w-6xl px-6 py-2 hidden md:flex items-center gap-0">
					for _, link := range data.NavLinks {
						<a
							href={ templ.SafeURL(link.URL) }
							data-public-nav-link
							class="public-nav-link font-mono text-xs uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors"
						>
							{ link.Label }
						</a>
					}
				</div>
			</div>
		}
	</nav>

	<!-- Mobile drawer -->
	@sheet.Sheet(sheet.SheetArgs{
		ID:    "mobile-nav-sheet",
		Modal: true,
		Side:  "left",
	}) {
		@sheet.SheetContent(sheet.SheetContentArgs{SheetID: "mobile-nav-sheet"}) {
			@sheet.SheetHeader(sheet.SheetHeaderArgs{}) {
				@sheet.SheetTitle(sheet.SheetTitleArgs{}) {
					{ config.Cfg.AppName }
				}
			}

			<!-- Mobile search -->
			<form action="/search" method="GET" data-public-search class="mt-6 mb-6">
				<div class="flex border-2 border-border">
					<input
						type="text"
						name="q"
						placeholder="SEARCH..."
						class="public-search-input border-none flex-1 w-full"
						autocomplete="off"
					/>
					<button type="submit" class="px-3 text-muted-foreground hover:text-foreground transition-colors cursor-pointer">
						@icon.Lucide("search", "size-4")
					</button>
				</div>
			</form>

			<!-- Mobile nav links -->
			if len(data.NavLinks) > 0 {
				<nav class="flex flex-col">
					for _, link := range data.NavLinks {
						<a
							href={ templ.SafeURL(link.URL) }
							data-public-nav-link
							class="font-mono text-sm uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors py-3 border-b border-border/40"
						>
							{ link.Label }
						</a>
					}
				</nav>
			}
		}
	}
}
