package episodeForm

import (
	"encoding/json"

	"github.com/gracchi-stdio/castogo/internal/domain"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
	"github.com/gracchi-stdio/castogo/internal/view/components/card"
	"github.com/gracchi-stdio/castogo/internal/view/components/form"
	"github.com/gracchi-stdio/castogo/internal/view/components/formactions"
	"github.com/gracchi-stdio/castogo/internal/view/components/formfield"
	"github.com/gracchi-stdio/castogo/internal/view/components/icon"
	"github.com/gracchi-stdio/castogo/internal/view/components/input"
	"github.com/gracchi-stdio/castogo/internal/view/components/loading"
	"github.com/gracchi-stdio/castogo/internal/view/components/textarea"
	"github.com/gracchi-stdio/castogo/internal/view/layout"
)

// Create renders the new-episode form (multipart — audio upload). Mirrors the
// edit page's card-based layout: a Details card (title + description) and an
// Audio File card, side by side in the same flex row. Both cards live inside a
// single <form> so one submit creates the episode with title, description, and
// audio together. The field set is intentionally minimal — slug, episode number,
// publish date, and explicit are refined later on the edit page.
templ Create(shared *domain.AdminSharedData) {
	{{
		signals := CreateSignals{}
		signalsJSON, _ := json.Marshal(signals)
	}}
	@layout.AdminLayout("New Episode", shared, createActions(), nil, formactions.FormActions(formactions.FormActionsArgs{
		FormID:      "episode-create-form",
		CancelLabel: "Cancel",
		SubmitLabel: "Create Episode",
		CancelHref:  "/admin/episodes",
	})) {
		<div data-signals={ string(signalsJSON) }>
			@loading.LoadingOverlay(loading.LoadingOverlayArgs{
				Signal: "uploading",
				Status: "uploading_status",
			})
			@form.Form(form.FormArgs{
				ID:          "episode-create-form",
				Action:      "/admin/episodes/create",
				ContentType: "form",
				Attributes: map[string]any{
					"enctype": "multipart/form-data",
				},
			}) {
				@card.Card(card.CardArgs{Class: "w-full max-w-5xl border-border/70 shadow-sm"}) {
					<div class="grid md:grid-cols-[11rem_minmax(0,1fr)]">
						<nav class="border-b p-4 md:border-b-0 md:border-r" aria-label="Episode sections">
							<p class="mb-3 px-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Episode settings</p>
							<div class="flex gap-1 overflow-x-auto md:flex-col">
								<a href="#new-episode-details" class="rounded-md bg-muted px-3 py-2 text-sm font-medium">Details</a>
								<a href="#new-episode-audio" class="rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground">Audio</a>
							</div>
						</nav>
						<div class="min-w-0 space-y-8 p-6">
							<section id="new-episode-details" class="scroll-mt-20">
								<div class="mb-5 border-b pb-3">
									<h2 class="text-base font-semibold tracking-tight">Episode details</h2>
									<p class="mt-1 text-sm text-muted-foreground">Add the public title and description for this episode.</p>
								</div>
							<div class="space-y-4">
								@formfield.FormField(formfield.FormFieldArgs{
									Name:        "title",
									Label:       "Title",
									Required:    true,
									ErrorSignal: "title_error",
								}) {
									@input.Input(input.InputArgs{
										Type:        "text",
										ID:          "title",
										Name:        "title",
										Placeholder: "My Awesome Episode",
										Class:       "w-full",
										Attributes: map[string]any{
											"data-on:input": "$title = el.value; $title_error = ''",
										},
									})
								}
								@formfield.FormField(formfield.FormFieldArgs{
									Name:        "description",
									Label:       "Description",
									ErrorSignal: "description_error",
								}) {
									@textarea.Textarea(textarea.TextareaArgs{
										ID:          "description",
										Name:        "description",
										Placeholder: "What's this episode about?",
										Class:       "w-full",
										Rows:        4,
										Attributes: map[string]any{
											"data-on:input": "$description = el.value; $description_error = ''",
										},
									})
								}
							</div>
							</section>
							<section id="new-episode-audio" class="scroll-mt-20 border-t pt-8">
								<div class="mb-5">
									<h2 class="text-base font-semibold tracking-tight">Audio file</h2>
									<p class="mt-1 text-sm text-muted-foreground">Upload the source audio; metadata is extracted automatically.</p>
								</div>
							<div class="space-y-4">
								@formfield.FormField(formfield.FormFieldArgs{
									Name:        "audio_file",
									Label:       "Audio File",
									Required:    true,
									ErrorSignal: "audio_file_error",
								}) {
									@input.Input(input.InputArgs{
										Type:  "file",
										ID:    "audio_file",
										Name:  "audio_file",
										Class: "w-full",
										Attributes: map[string]any{
											"accept":                "audio/*",
											"data-on:change":        "$audio_file_error = ''; window.extractAudioMetadata(el)",
											"data-on:audiometadata": audioMetadataHandler,
										},
									})
								}
								<!-- Audio metadata preview (display-only; server recomputes) -->
								<div data-show="$metadata_extracted" class="p-4 rounded-md border bg-muted/50">
									<h4 class="text-sm font-medium mb-2">Audio Metadata</h4>
									<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
										<div>
											<span class="text-muted-foreground">Duration</span>
											<p class="font-medium" data-text="$audio_duration"></p>
										</div>
										<div>
											<span class="text-muted-foreground">Sample Rate</span>
											<p class="font-medium" data-text="$audio_sample_rate"></p>
										</div>
										<div>
											<span class="text-muted-foreground">Channels</span>
											<p class="font-medium" data-text="$audio_channel_count"></p>
										</div>
										<div>
											<span class="text-muted-foreground">Bitrate</span>
											<p class="font-medium" data-text="$audio_bitrate"></p>
										</div>
										<div>
											<span class="text-muted-foreground">Format</span>
											<p class="font-medium" data-text="$audio_format"></p>
										</div>
										<div>
											<span class="text-muted-foreground">MIME Type</span>
											<p class="font-medium" data-text="$audio_mime_type"></p>
										</div>
										<div>
											<span class="text-muted-foreground">File Size</span>
											<p class="font-medium" data-text="$audio_file_size"></p>
										</div>
									</div>
								</div>
							</div>
							</section>
						</div>
					</div>
				}
			}
		</div>
	}
}

templ createActions() {
	<a href="/admin/episodes">
		@button.Button(button.ButtonArgs{
			Variant: "outline",
			Size:    "sm",
		}) {
			@icon.Lucide("arrow-left", "size-4 mr-1")
			Back to Episodes
		}
	</a>
}
