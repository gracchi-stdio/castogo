package settings

import (
	"encoding/json"

	"github.com/gracchi-stdio/castogo/internal/view/components/card"
	"github.com/gracchi-stdio/castogo/internal/view/components/form"
	"github.com/gracchi-stdio/castogo/internal/view/components/formfield"
	"github.com/gracchi-stdio/castogo/internal/view/components/imageupload"
	"github.com/gracchi-stdio/castogo/internal/view/components/input"
	"github.com/gracchi-stdio/castogo/internal/view/components/loading"
	selectcomponent "github.com/gracchi-stdio/castogo/internal/view/components/select"
	"github.com/gracchi-stdio/castogo/internal/view/components/textarea"
)

// Form renders the settings form. The form tag has id="settings-form" so the
// sticky-footer submit button (rendered by formactions via AdminLayout's footer
// slot) can bind to it via form="settings-form".
templ Form(args Args) {
	{{
		signals := NewSignals(args.Config)
		signalsJSON, _ := json.Marshal(signals)
		categoryOpts := CategoryOptions()
		subcategoryOpts := SubcategoryOptions(signals.Category)
		configID := int64(0)
		if args.Config != nil {
			configID = args.Config.ID
		}
	}}
	<div data-signals={ string(signalsJSON) }>
		@loading.LoadingOverlay(loading.LoadingOverlayArgs{
			Signal: "cover_uploading",
			Status: "cover_status",
		})
		@card.Card(card.CardArgs{Class: "mb-6 max-w-3xl border-border/70 shadow-sm"}) {
			@card.CardHeader(card.CardHeaderArgs{}) {
				@card.CardTitle(card.CardTitleArgs{}) { Cover image }
				@card.CardDescription(card.CardDescriptionArgs{}) { Upload a square JPG, PNG, or WebP image for your podcast artwork. }
			}
			@card.CardContent(card.CardContentArgs{}) {
				@form.Form(form.FormArgs{
					ID:         "settings-cover-form",
					Attributes: map[string]any{"enctype": "multipart/form-data"},
				}) {
					@imageupload.ImageUpload(imageupload.ImageUploadArgs{
						SignalName: "cover_image_url",
						UploadURL:  "/admin/settings/upload-cover",
						FormID:     "settings-cover-form",
						UploadingSignal: "cover_uploading",
						StatusSignal:    "cover_status",
						Label:      "Cover Image",
						ID:         "cover_image",
						Hint:       "Recommended: 3000x3000px, JPG or PNG",
						PreviewW:   "w-48",
						PreviewH:   "h-48",
					})
					<input type="hidden" name="id" value={ configID }/>
				}
			}
		}
		@form.Form(form.FormArgs{
			ID:          "settings-form",
			Action:      "/admin/settings",
			ContentType: "json",
		}) {
			@card.Card(card.CardArgs{Class: "max-w-5xl border-border/70 shadow-sm"}) {
				@card.CardContent(card.CardContentArgs{}) {
					<div class="space-y-8">
						<!-- Podcast Info -->
						<div>
							<div class="mb-4 border-b pb-3">
								<h3 class="text-base font-semibold tracking-tight">Podcast identity</h3>
								<p class="mt-1 text-sm text-muted-foreground">The public details listeners see in your podcast directory and feed.</p>
							</div>
							<div class="space-y-4">
								@formfield.FormField(formfield.FormFieldArgs{
									Name:        "title",
									Label:       "Title",
									Required:    true,
									ErrorSignal: "title_error",
								}) {
									@input.Input(input.InputArgs{
										Type:        "text",
										ID:          "title",
										Name:        "title",
										Placeholder: "My Awesome Podcast",
										Class:       "w-full",
										Attributes: map[string]any{
											"data-bind":              "title",
											"data-on:input":          "$title_error = ''",
											"data-attr:aria-invalid": "$title_error != '' ? 'true' : ''",
										},
									})
								}
								@formfield.FormField(formfield.FormFieldArgs{
									Name:  "description",
									Label: "Description",
								}) {
									@textarea.Textarea(textarea.TextareaArgs{
										ID:          "description",
										Name:        "description",
										Placeholder: "What's your podcast about?",
										Class:       "w-full",
										Rows:        4,
										Attributes: map[string]any{
											"data-bind:description": "",
										},
									})
								}
								@formfield.FormField(formfield.FormFieldArgs{
									Name:        "site_url",
									Label:       "Site URL",
									ErrorSignal: "site_url_error",
								}) {
									@input.Input(input.InputArgs{
										Type:        "url",
										ID:          "site_url",
										Name:        "site_url",
										Placeholder: "https://example.com",
										Class:       "w-full",
										Attributes: map[string]any{
											"data-bind":              "site_url",
											"data-on:input":          "$site_url_error = ''",
											"data-attr:aria-invalid": "$site_url_error != '' ? 'true' : ''",
										},
									})
								}
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "language",
										Label: "Language",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "language",
											Name:        "language",
											Placeholder: "en",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind": "language",
											},
										})
									}
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "copyright",
										Label: "Copyright",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "copyright",
											Name:        "copyright",
											Placeholder: "2026 My Podcast",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind": "copyright",
											},
										})
									}
								</div>
							</div>
						</div>
						<!-- Author & Owner -->
						<div>
							<div class="mb-4 border-b pb-3">
								<h3 class="text-base font-semibold tracking-tight">People</h3>
								<p class="mt-1 text-sm text-muted-foreground">Set the contact details attached to your podcast.</p>
							</div>
							<div class="space-y-4">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "author_name",
										Label: "Author Name",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "author_name",
											Name:        "author_name",
											Placeholder: "John Doe",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind": "author_name",
											},
										})
									}
									@formfield.FormField(formfield.FormFieldArgs{
										Name:        "author_email",
										Label:       "Author Email",
										ErrorSignal: "author_email_error",
									}) {
										@input.Input(input.InputArgs{
											Type:        "email",
											ID:          "author_email",
											Name:        "author_email",
											Placeholder: "john@example.com",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind":              "author_email",
												"data-on:input":          "$author_email_error = ''",
												"data-attr:aria-invalid": "$author_email_error != '' ? 'true' : ''",
											},
										})
									}
								</div>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "owner_name",
										Label: "Owner Name",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "owner_name",
											Name:        "owner_name",
											Placeholder: "John Doe",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind": "owner_name",
											},
										})
									}
									@formfield.FormField(formfield.FormFieldArgs{
										Name:        "owner_email",
										Label:       "Owner Email",
										ErrorSignal: "owner_email_error",
									}) {
										@input.Input(input.InputArgs{
											Type:        "email",
											ID:          "owner_email",
											Name:        "owner_email",
											Placeholder: "john@example.com",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind":              "owner_email",
												"data-on:input":          "$owner_email_error = ''",
												"data-attr:aria-invalid": "$owner_email_error != '' ? 'true' : ''",
											},
										})
									}
								</div>
							</div>
						</div>
						<!-- Category -->
						<div>
							<div class="mb-4 border-b pb-3">
								<h3 class="text-base font-semibold tracking-tight">Categories</h3>
								<p class="mt-1 text-sm text-muted-foreground">Choose the primary directory category and an optional subcategory.</p>
							</div>
							<div class="space-y-4">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:        "category",
										Label:       "Category",
										ErrorSignal: "category_error",
									}) {
										@selectcomponent.Select(selectcomponent.SelectArgs{
											ID:           "category_select",
											Name:         "category",
											Placeholder:  "Select category...",
											Class:        "w-full",
											Options:      categoryOpts,
											ContentClass: "max-h-32",
											Value:        signals.Category,
											OnChange:     "$category = $category_select.value; $category_error = ''; @get('/admin/settings/subcategories?category=' + encodeURIComponent($category_select.value))",
										})
									}
									<!-- Subcategory (SSE-swapped wrapper) -->
									<div class="space-y-2">
										<div id="subcategory_wrapper" class="space-y-2">
											@SubcategoryFragment(subcategoryOpts, signals.Subcategory)
										</div>
										<p
											class="text-destructive text-sm"
											data-show="$subcategory_error != ''"
											data-text="$subcategory_error"
										></p>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			}
		}
	</div>
}
