package settings

import (
	"github.com/gracchi-stdio/castogo/internal/view/components/card"
	"github.com/gracchi-stdio/castogo/internal/view/components/form"
	"github.com/gracchi-stdio/castogo/internal/view/components/formfield"
	"github.com/gracchi-stdio/castogo/internal/view/components/input"
	"github.com/gracchi-stdio/castogo/internal/view/components/loading"
	selectcomponent "github.com/gracchi-stdio/castogo/internal/view/components/select"
	"github.com/gracchi-stdio/castogo/internal/view/components/textarea"
)

// Form renders the settings form. The form tag has id="settings-form" so the
// sticky-footer submit button (rendered by formactions via AdminLayout's footer
// slot) can bind to it via form="settings-form".
templ Form(args Args) {
	{{
		signals := NewSignals(args.Config)
		formSignals := form.SignalsWithFormId("settings", signals)
		categoryOpts := CategoryOptions()
		subcategoryOpts := SubcategoryOptions(signals.Category)
		configID := int64(0)
		if args.Config != nil {
			configID = args.Config.ID
		}
	}}
	<div data-signals={ formSignals.DataSignals }>
		@loading.LoadingOverlay(loading.LoadingOverlayArgs{
			Signal: "cover_uploading",
			Status: "cover_status",
		})
		@form.Form(form.FormArgs{
			ID:          "settings-form",
			Action:      "/admin/settings",
			ContentType: "form",
			Attributes: map[string]any{
				"enctype": "multipart/form-data",
			},
		}) {
			@card.Card(card.CardArgs{}) {
				@card.CardContent(card.CardContentArgs{}) {
					<div class="space-y-6">
						<!-- Podcast Info -->
						<div>
							<h3 class="text-lg font-medium mb-4">Podcast Info</h3>
							<div class="space-y-4">
								@formfield.FormField(formfield.FormFieldArgs{
									Name:        "title",
									Label:       "Title",
									Required:    true,
									ErrorSignal: "title_error",
								}) {
									@input.Input(input.InputArgs{
										Type:        "text",
										ID:          "title",
										Name:        "title",
										Placeholder: "My Awesome Podcast",
										Class:       "w-full",
										Attributes: map[string]any{
											"data-on:input":          "$title = el.value; $title_error = ''",
											"data-attr:aria-invalid": "$title_error != '' ? 'true' : ''",
										},
									})
								}
								@formfield.FormField(formfield.FormFieldArgs{
									Name:  "description",
									Label: "Description",
								}) {
									@textarea.Textarea(textarea.TextareaArgs{
										ID:          "description",
										Name:        "description",
										Placeholder: "What's your podcast about?",
										Class:       "w-full",
										Rows:        4,
										Attributes: map[string]any{
											"data-bind:description": "",
										},
									})
								}
								<!-- Cover Image Upload (custom UX — not a FormField) -->
								<div class="space-y-2">
									<span class="text-sm font-medium leading-none">Cover Image</span>
									@input.Input(input.InputArgs{
										Type:        "hidden",
										ID:          "cover_image_url",
										Name:        "cover_image_url",
										Placeholder: "https://cdn.example.com/cover.jpg",
										Class:       "w-full",
										Attributes: map[string]any{
											"data-bind:cover_image_url": "",
										},
									})
									<p
										class="text-destructive text-sm"
										data-show="$cover_image_url_error != ''"
										data-text="$cover_image_url_error"
									></p>
									<!-- No image: dashed upload area -->
									<div
										data-show="$cover_image_url === ''"
										class="border-2 border-dashed border-muted-foreground/25 rounded-lg p-8 text-center cursor-pointer hover:border-muted-foreground/50 transition-colors"
										data-on:click="document.getElementById('cover_image').click()"
									>
										<div class="text-muted-foreground">
											<p class="font-medium">Click to upload cover image</p>
											<p class="text-sm mt-1">Recommended: 3000x3000px, JPG or PNG</p>
										</div>
									</div>
									<!-- Has image: preview + change button -->
									<div data-show="$cover_image_url !== ''" class="space-y-3">
										<button
											type="button"
											class="text-sm text-muted-foreground hover:text-foreground transition-colors"
											data-on:click="document.getElementById('cover_image').click()"
										>
											<img
												data-attr:src="$cover_image_url"
												alt="Cover image preview"
												class="w-48 h-48 object-cover rounded-lg border"
											/>
										</button>
									</div>
									<!-- Hidden file input (shared by both states) -->
									<input
										type="file"
										id="cover_image"
										name="cover_image"
										accept="image/jpeg,image/png,image/webp"
										class="hidden"
										data-on:change="$cover_status = 'Uploading cover image...'; $cover_uploading = true; @post('/admin/settings/upload-cover', {contentType: 'form', form: '#settings-form'})"
									/>
								</div>
								@formfield.FormField(formfield.FormFieldArgs{
									Name:        "site_url",
									Label:       "Site URL",
									ErrorSignal: "site_url_error",
								}) {
									@input.Input(input.InputArgs{
										Type:        "url",
										ID:          "site_url",
										Name:        "site_url",
										Placeholder: "https://example.com",
										Class:       "w-full",
										Attributes: map[string]any{
											"data-on:input":          "$site_url = el.value; $site_url_error = ''",
											"data-bind:site_url":     "",
											"data-attr:aria-invalid": "$site_url_error != '' ? 'true' : ''",
										},
									})
								}
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "language",
										Label: "Language",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "language",
											Name:        "language",
											Placeholder: "en",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind:language": "",
											},
										})
									}
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "copyright",
										Label: "Copyright",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "copyright",
											Name:        "copyright",
											Placeholder: "2026 My Podcast",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind:copyright": "",
											},
										})
									}
								</div>
							</div>
						</div>
						<!-- Author & Owner -->
						<div>
							<h3 class="text-lg font-medium mb-4">Author & Owner</h3>
							<div class="space-y-4">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "author_name",
										Label: "Author Name",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "author_name",
											Name:        "author_name",
											Placeholder: "John Doe",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind:author_name": "",
											},
										})
									}
									@formfield.FormField(formfield.FormFieldArgs{
										Name:        "author_email",
										Label:       "Author Email",
										ErrorSignal: "author_email_error",
									}) {
										@input.Input(input.InputArgs{
											Type:        "email",
											ID:          "author_email",
											Name:        "author_email",
											Placeholder: "john@example.com",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-on:input":          "$author_email = el.value; $author_email_error = ''",
												"data-bind:author_email": "",
												"data-attr:aria-invalid": "$author_email_error != '' ? 'true' : ''",
											},
										})
									}
								</div>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "owner_name",
										Label: "Owner Name",
									}) {
										@input.Input(input.InputArgs{
											Type:        "text",
											ID:          "owner_name",
											Name:        "owner_name",
											Placeholder: "John Doe",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-bind:owner_name": "",
											},
										})
									}
									@formfield.FormField(formfield.FormFieldArgs{
										Name:        "owner_email",
										Label:       "Owner Email",
										ErrorSignal: "owner_email_error",
									}) {
										@input.Input(input.InputArgs{
											Type:        "email",
											ID:          "owner_email",
											Name:        "owner_email",
											Placeholder: "john@example.com",
											Class:       "w-full",
											Attributes: map[string]any{
												"data-on:input":          "$owner_email = el.value; $owner_email_error = ''",
												"data-bind:owner_email":  "",
												"data-attr:aria-invalid": "$owner_email_error != '' ? 'true' : ''",
											},
										})
									}
								</div>
							</div>
						</div>
						<!-- Category -->
						<div>
							<h3 class="text-lg font-medium mb-4">Category</h3>
							<div class="space-y-4">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									@formfield.FormField(formfield.FormFieldArgs{
										Name:  "category",
										Label: "Category",
									}) {
										@selectcomponent.Select(selectcomponent.SelectArgs{
											ID:           "category_select",
											Name:         "category",
											Placeholder:  "Select category...",
											Class:        "w-full",
											Options:      categoryOpts,
											ContentClass: "max-h-32",
											Value:        signals.Category,
											OnChange:     "@get('/admin/settings/subcategories?category=' + encodeURIComponent($category_select.value))",
										})
									}
									<!-- Subcategory (SSE-swapped wrapper) -->
									<div class="space-y-2">
										<div id="subcategory_wrapper" class="space-y-2">
											@SubcategoryFragment(subcategoryOpts, signals.Subcategory)
										</div>
										<p
											class="text-destructive text-sm"
											data-show="$subcategory_error != ''"
											data-text="$subcategory_error"
										></p>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			}
			<input type="hidden" name="id" value={ configID }/>
		}
	</div>
}
