package settings

import (
	selectcomponent "github.com/gracchi-stdio/castogo/internal/view/components/select"
)

// SubcategoryFragment is the SSE-swapped content for #subcategory_wrapper.
// Rendered by GET /admin/settings/subcategories when category changes.
templ SubcategoryFragment(options []selectcomponent.SelectOptionArgs, selected string) {
	{{
		labelClass := ""
		if len(options) == 0 {
			labelClass = "hidden"
		}
	}}
	<label for="subcategory_select" class={ "text-sm font-medium leading-none", labelClass }>
		Subcategory
	</label>
	@selectcomponent.Select(selectcomponent.SelectArgs{
		ID:           "subcategory_select",
		Name:         "subcategory",
		Placeholder:  "Select subcategory...",
		Options:      options,
		ContentClass: "max-h-32",
		Value:        selected,
		Disabled:     len(options) == 0,
	})
}
