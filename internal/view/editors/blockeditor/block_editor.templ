templ testimonialItemEditor(pageID int64, blockID int64, pfx string, index int, item map[string]any) {
	<div class="border rounded-lg p-3 space-y-2">
		<div class="flex items-center justify-between">
			<span class="text-xs font-medium text-muted-foreground">Testimonial { fmt.Sprintf("%d", index+1) }</span>
			@button.Button(button.ButtonArgs{
				Variant: "ghost", Size: "icon", Type: "button",
				Attributes: map[string]any{
					"data-on:click": fmt.Sprintf("@delete('/admin/pages/%d/blocks/%d/items/%d?type=testimonial')", pageID, blockID, index),
				},
			}) {
				@icon.Lucide("trash-2", "size-4 text-muted-foreground")
			}
		</div>
		@textarea.Textarea(textarea.TextareaArgs{
			Placeholder: "Quote…",
			Class:       "w-full",
			Attributes:  bindAttr(pfx, fmt.Sprintf("item_%d_quote", index)),
		})
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Author name",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("item_%d_author", index)),
		})
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Author role (e.g. Listener)",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("item_%d_role", index)),
		})
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Avatar URL (optional)",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("item_%d_avatar_url", index)),
		})
	</div>
}

templ footerEditor(pageID int64, block *domain.PageBlock, pfx string) {
	{{ content := parseBlockContent(block) }}
	{{ links := toItems(content["links"]) }}
	{{ socialLinks := toItems(content["social_links"]) }}
	<div class="space-y-3">
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Copyright
			}
			@input.Input(input.InputArgs{
				Type: "text", Placeholder: "© 2026 My Podcast",
				Class: "w-full", Attributes: bindAttr(pfx, "copyright"),
			})
		</div>
		<div class="space-y-2">
			<div class="flex items-center justify-between">
				@label.Label(label.LabelArgs{}) {
					Navigation Links
				}
				@button.Button(button.ButtonArgs{
					Variant: "outline", Size: "sm", Type: "button",
					Attributes: map[string]any{
						"data-on:click": fmt.Sprintf("@post('/admin/pages/%d/blocks/%d/items?type=link')", pageID, block.ID),
					},
				}) {
					@icon.Lucide("plus", "size-4 mr-1")
					Add Link
				}
			</div>
			<div id={ fmt.Sprintf("block-%d-footer-links", block.ID) } class="space-y-2">
				for i, link := range links {
					@footerLinkEditor(pageID, block.ID, pfx, i, link)
				}
			</div>
		</div>
		<div class="space-y-2">
			<div class="flex items-center justify-between">
				@label.Label(label.LabelArgs{}) {
					Social Links
				}
				@button.Button(button.ButtonArgs{
					Variant: "outline", Size: "sm", Type: "button",
					Attributes: map[string]any{
						"data-on:click": fmt.Sprintf("@post('/admin/pages/%d/blocks/%d/items?type=social')", pageID, block.ID),
					},
				}) {
					@icon.Lucide("plus", "size-4 mr-1")
					Add Social
				}
			</div>
			<div id={ fmt.Sprintf("block-%d-footer-social", block.ID) } class="space-y-2">
				for i, link := range socialLinks {
					@footerSocialEditor(pageID, block.ID, pfx, i, link)
				}
			</div>
		</div>
	</div>
}

templ footerLinkEditor(pageID int64, blockID int64, pfx string, index int, link map[string]any) {
	<div class="border rounded-lg p-3 space-y-2">
		<div class="flex items-center justify-between">
			<span class="text-xs font-medium text-muted-foreground">Link { fmt.Sprintf("%d", index+1) }</span>
			@button.Button(button.ButtonArgs{
				Variant: "ghost", Size: "icon", Type: "button",
				Attributes: map[string]any{
					"data-on:click": fmt.Sprintf("@delete('/admin/pages/%d/blocks/%d/items/%d?type=link')", pageID, blockID, index),
				},
			}) {
				@icon.Lucide("trash-2", "size-4 text-muted-foreground")
			}
		</div>
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Label",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("link_%d_label", index)),
		})
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "URL",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("link_%d_url", index)),
		})
	</div>
}

templ footerSocialEditor(pageID int64, blockID int64, pfx string, index int, link map[string]any) {
	<div class="border rounded-lg p-3 space-y-2">
		<div class="flex items-center justify-between">
			<span class="text-xs font-medium text-muted-foreground">Social { fmt.Sprintf("%d", index+1) }</span>
			@button.Button(button.ButtonArgs{
				Variant: "ghost", Size: "icon", Type: "button",
				Attributes: map[string]any{
					"data-on:click": fmt.Sprintf("@delete('/admin/pages/%d/blocks/%d/items/%d?type=social')", pageID, blockID, index),
				},
			}) {
				@icon.Lucide("trash-2", "size-4 text-muted-foreground")
			}
		</div>
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Platform (e.g. twitter, github)",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("social_%d_platform", index)),
		})
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "URL",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("social_%d_url", index)),
		})
	</div>
}

templ addBlockControls(pageID int64) {
	<div
		class="flex items-center gap-2"
		data-signals:new_block_type="'hero'"
	>
		@selectcomponent.Select(selectcomponent.SelectArgs{
			ID:           "add-block-select",
			DefaultValue: "hero",
			Options: []selectcomponent.SelectOptionArgs{
				{Value: "hero", Label: "Hero"},
				{Value: "features", Label: "Features"},
				{Value: "episodes_showcase", Label: "Episodes"},
				{Value: "testimonials", Label: "Testimonials"},
				{Value: "cta", Label: "Call to Action"},
				{Value: "footer", Label: "Footer"},
				{Value: "prose", Label: "Rich Text"},
			},
			Placeholder: "Block type",
			Class:       "w-40",
			OnChange:    "$new_block_type = $add_block_select.value",
		})
		@button.Button(button.ButtonArgs{
			Variant: "outline",
			Size:    "sm",
			Type:    "button",
			Attributes: map[string]any{
				"data-on:click": fmt.Sprintf("@post('/admin/pages/%d/blocks')", pageID),
			},
		}) {
			@icon.Lucide("plus", "size-4 mr-1")
			Add Block
		}
	</div>
}

templ blockListEmpty() {
	<div class="flex flex-col items-center gap-2 py-6 text-center">
		@icon.Lucide("layers", "size-8 text-muted-foreground/30")
		<p class="text-sm text-muted-foreground">No blocks yet. Add blocks to build your page layout.</p>
	</div>
}

// blockSummarySignal returns a Datastar expression for the block's summary signal.
func blockSummarySignal(block *domain.PageBlock) string {
	pfx := blockEditPrefix(block, "")
	switch block.BlockType {
	case "hero":
		return fmt.Sprintf("$%sheadline !== '' ? $%sheadline : ($%ssubheadline !== '' ? $%ssubheadline : 'Empty block')", pfx, pfx, pfx, pfx)
	case "cta":
		return fmt.Sprintf("$%sheadline !== '' ? $%sheadline : ($%sdescription !== '' ? $%sdescription : 'Empty block')", pfx, pfx, pfx, pfx)
	case "features", "testimonials", "episodes_showcase":
		return fmt.Sprintf("$%ssection_title !== '' ? $%ssection_title : 'Empty block'", pfx, pfx)
	case "footer":
		return fmt.Sprintf("$%scopyright !== '' ? $%scopyright : 'Empty block'", pfx, pfx)
	case "prose":
		return fmt.Sprintf("$%sbody !== '' ? $%sbody.substring(0, 50) + ($%sbody.length > 50 ? '...' : '') : 'Empty block'", pfx, pfx, pfx)
	}
	return "'Empty block'"
}

func blockTypeLabel(blockType string) string {
	labels := map[string]string{
		"hero":              "Hero",
		"features":          "Features",
		"episodes_showcase": "Episodes",
		"testimonials":      "Testimonials",
		"cta":               "Call to Action",
		"footer":            "Footer",
		"prose":             "Rich Text",
	}
	if label, ok := labels[blockType]; ok {
		return label
	}
	return blockType
}

func blockSummary(block *domain.PageBlock) string {
	var raw map[string]any
	if err := json.Unmarshal(block.Content, &raw); err != nil {
		return "Empty block"
	}
	switch block.BlockType {
	case "hero":
		if headline, ok := raw["headline"].(string); ok && headline != "" {
			return headline
		}
	case "features":
		if title, ok := raw["section_title"].(string); ok && title != "" {
			return title
		}
	case "cta":
		if headline, ok := raw["headline"].(string); ok && headline != "" {
			return headline
		}
	case "testimonials":
		if title, ok := raw["section_title"].(string); ok && title != "" {
			return title
		}
	}
	return "Empty block"
}

// parseBlockContent returns the block's JSON content as a map, or an empty map.
func parseBlockContent(block *domain.PageBlock) map[string]any {
	var raw map[string]any
	if err := json.Unmarshal(block.Content, &raw); err != nil {
		return map[string]any{}
	}
	return raw
}

// toItems converts a JSON items array to []map[string]any.
func toItems(v any) []map[string]any {
	if v == nil {
		return nil
	}
	arr, ok := v.([]any)
	if !ok {
		return nil
	}
	items := make([]map[string]any, 0, len(arr))
	for _, item := range arr {
		if m, ok := item.(map[string]any); ok {
			items = append(items, m)
		}
	}
	return items
}

// blockEditPrefix returns the signal prefix for a block e.g. "block_5_" or "block_5_editing".
func blockEditPrefix(block *domain.PageBlock, suffix string) string {
	base := fmt.Sprintf("block_%d_", block.ID)
	if suffix == "" {
		return base
	}
	return base + suffix
}

// blockSignalAttrs returns the data-signals-* HTML attributes for a block's editable fields.
func blockSignalAttrs(block *domain.PageBlock) templ.Attributes {
	content := parseBlockContent(block)
	pfx := blockEditPrefix(block, "")

	sig := func(name string) string { return "data-signals:" + pfx + name }

	attrs := templ.Attributes{
		sig("editing"):    "false",
		sig("block_type"): fmt.Sprintf("'%s'", block.BlockType),
	}

	switch block.BlockType {
	case "hero":
		attrs[sig("headline")] = jsSignalVal(content["headline"])
		attrs[sig("subheadline")] = jsSignalVal(content["subheadline"])
		attrs[sig("cta_text")] = jsSignalVal(content["cta_text"])
		attrs[sig("cta_url")] = jsSignalVal(content["cta_url"])
		attrs[sig("background_image")] = jsSignalVal(content["background_image"])
		attrs[sig("overlay_opacity")] = jsSignalVal(content["overlay_opacity"])
	case "cta":
		desc := content["description"]
		if desc == nil {
			desc = content["subheadline"]
		}
		attrs[sig("headline")] = jsSignalVal(content["headline"])
		attrs[sig("description")] = jsSignalVal(desc)
		attrs[sig("button_text")] = jsSignalVal(content["button_text"])
		attrs[sig("button_url")] = jsSignalVal(content["button_url"])
	case "features":
		attrs[sig("section_title")] = jsSignalVal(content["section_title"])
		attrs[sig("section_description")] = jsSignalVal(content["section_description"])
		if items := toItems(content["items"]); items != nil {
			for i, item := range items {
				attrs[sig(fmt.Sprintf("item_%d_icon", i))] = jsSignalVal(item["icon"])
				attrs[sig(fmt.Sprintf("item_%d_title", i))] = jsSignalVal(item["title"])
				attrs[sig(fmt.Sprintf("item_%d_description", i))] = jsSignalVal(item["description"])
			}
		}
	case "episodes_showcase":
		attrs[sig("section_title")] = jsSignalVal(content["section_title"])
		attrs[sig("section_description")] = jsSignalVal(content["section_description"])
		attrs[sig("max_episodes")] = jsNumberSignalVal(content["max_episodes"])
		attrs[sig("display_mode")] = jsSignalVal(content["display_mode"])
	case "testimonials":
		attrs[sig("section_title")] = jsSignalVal(content["section_title"])
		attrs[sig("section_description")] = jsSignalVal(content["section_description"])
		if items := toItems(content["items"]); items != nil {
			for i, item := range items {
				attrs[sig(fmt.Sprintf("item_%d_quote", i))] = jsSignalVal(item["quote"])
				attrs[sig(fmt.Sprintf("item_%d_author", i))] = jsSignalVal(item["author"])
				attrs[sig(fmt.Sprintf("item_%d_role", i))] = jsSignalVal(item["role"])
				attrs[sig(fmt.Sprintf("item_%d_avatar_url", i))] = jsSignalVal(item["avatar_url"])
			}
		}
	case "footer":
		attrs[sig("copyright")] = jsSignalVal(content["copyright"])
		attrs[sig("text")] = jsSignalVal(content["text"])
		if links := toItems(content["links"]); links != nil {
			for i, link := range links {
				attrs[sig(fmt.Sprintf("link_%d_label", i))] = jsSignalVal(link["label"])
				attrs[sig(fmt.Sprintf("link_%d_url", i))] = jsSignalVal(link["url"])
			}
		}
		if socialLinks := toItems(content["social_links"]); socialLinks != nil {
			for i, link := range socialLinks {
				attrs[sig(fmt.Sprintf("social_%d_platform", i))] = jsSignalVal(link["platform"])
				attrs[sig(fmt.Sprintf("social_%d_url", i))] = jsSignalVal(link["url"])
			}
		}
	case "prose":
		attrs[sig("body")] = jsSignalVal(content["body"])
	}

	return attrs
}

// jsSignalVal converts a Go value to a JS signal string literal.
// Strings are wrapped in single quotes with internal quotes escaped.
// nil/empty returns "".
func jsSignalVal(v any) string {
	if v == nil {
		return "''"
	}
	s, ok := v.(string)
	if !ok || s == "" {
		return "''"
	}
	escaped := strings.NewReplacer("\\", "\\\\", "'", "\\'").Replace(s)
	return fmt.Sprintf("'%s'", escaped)
}

// jsNumberSignalVal converts a Go value to a JS number signal.
func jsNumberSignalVal(v any) string {
	if v == nil {
		return "0"
	}
	if f, ok := v.(float64); ok {
		return fmt.Sprintf("%d", int(f))
	}
	return "0"
}

// displayModeVal returns the display_mode from block content, defaulting to "grid".
func displayModeVal(block *domain.PageBlock) string {
	content := parseBlockContent(block)
	if v, ok := content["display_mode"].(string); ok && v != "" {
		return v
	}
	return "grid"
}
