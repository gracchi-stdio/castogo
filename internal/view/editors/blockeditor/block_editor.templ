package blockEditor

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/gracchi-stdio/castogo/internal/domain"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
	"github.com/gracchi-stdio/castogo/internal/view/components/form"
	"github.com/gracchi-stdio/castogo/internal/view/components/icon"
	"github.com/gracchi-stdio/castogo/internal/view/components/imageupload"
	"github.com/gracchi-stdio/castogo/internal/view/components/input"
	"github.com/gracchi-stdio/castogo/internal/view/components/label"
	selectcomponent "github.com/gracchi-stdio/castogo/internal/view/components/select"
	"github.com/gracchi-stdio/castogo/internal/view/components/textarea"
)

templ BlockEditor(pageID int64, blocks []*domain.PageBlock) {
	<div class="space-y-4">
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-medium">Blocks</h3>
			@addBlockControls(pageID)
		</div>
		if len(blocks) > 0 {
			@blockList(pageID, blocks)
		} else {
			@blockListEmpty()
		}
	</div>
}

templ blockList(pageID int64, blocks []*domain.PageBlock) {
	<div id="block-list" class="space-y-2">
		for i, block := range blocks {
			@blockCard(pageID, block, i)
		}
	</div>
}

templ blockCard(pageID int64, block *domain.PageBlock, index int) {
	<div data-block-id={ fmt.Sprintf("%d", block.ID) } class="rounded-lg border bg-card text-card-foreground shadow-sm group px-4">
		<div data-slot="card-content" class="">
			<div
				{ blockSignalAttrs(block)... }
			>
				<!-- View mode -->
				<div data-show={ fmt.Sprintf("!$%s", blockEditPrefix(block, "editing")) } class="flex items-center justify-between py-3">
					<div class="flex items-center gap-3">
						<span class="flex items-center justify-center w-7 h-7 rounded-md bg-muted text-xs font-medium text-muted-foreground">
							{ fmt.Sprintf("%d", index+1) }
						</span>
						<div>
							<p class="font-medium text-sm">{ blockTypeLabel(block.BlockType) }</p>
							<p class="text-xs text-muted-foreground" data-text={ blockSummarySignal(block) }></p>
						</div>
					</div>
					<div class="flex items-center gap-2">
						@button.Button(button.ButtonArgs{
							Variant: "ghost",
							Size:    "sm",
							Type:    "button",
							Attributes: map[string]any{
								"data-on:click": fmt.Sprintf("$%s = true", blockEditPrefix(block, "editing")),
							},
						}) {
							@icon.Lucide("pencil", "size-4 mr-1")
							Edit
						}
						@button.Button(button.ButtonArgs{
							Variant: "ghost",
							Size:    "icon",
							Type:    "button",
							Attributes: map[string]any{
								"data-on:click": fmt.Sprintf("@delete('/admin/pages/%d/blocks/%d')", pageID, block.ID),
							},
						}) {
							@icon.Lucide("trash-2", "size-4 text-muted-foreground")
						}
					</div>
				</div>
				<!-- Edit mode -->
				<div data-show={ fmt.Sprintf("$%s", blockEditPrefix(block, "editing")) } class="px-4 py-3 space-y-3">
					<div class="flex items-center justify-between">
						<span class="font-medium text-sm">{ blockTypeLabel(block.BlockType) }</span>
						@button.Button(button.ButtonArgs{
							Variant: "ghost",
							Size:    "icon",
							Type:    "button",
							Attributes: map[string]any{
								"data-on:click": fmt.Sprintf("$%s = false", blockEditPrefix(block, "editing")),
							},
						}) {
							@icon.Lucide("x", "size-4")
						}
					</div>
					@blockEditFields(pageID, block)
				</div>
			</div>
		</div>
	</div>
}

func bindAttr(pfx, field string) templ.Attributes {
	return templ.Attributes{
		"data-bind:" + pfx + field: "",
	}
}

templ blockEditFields(pageID int64, block *domain.PageBlock) {
	{{ pfx := blockEditPrefix(block, "") }}
	switch block.BlockType {
		case "hero":
			<div class="space-y-3">
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						Headline
					}
					@input.Input(input.InputArgs{
						Type: "text", Placeholder: "Enter headline…",
						Class: "w-full", Attributes: bindAttr(pfx, "headline"),
					})
				</div>
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						Subheadline
					}
					@input.Input(input.InputArgs{
						Type: "text", Placeholder: "Enter subheadline…",
						Class: "w-full", Attributes: bindAttr(pfx, "subheadline"),
					})
				</div>
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						CTA Text
					}
					@input.Input(input.InputArgs{
						Type: "text", Placeholder: "e.g. Listen Now",
						Class: "w-full", Attributes: bindAttr(pfx, "cta_text"),
					})
				</div>
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						CTA URL
					}
					@input.Input(input.InputArgs{
						Type: "text", Placeholder: "/episodes",
						Class: "w-full", Attributes: bindAttr(pfx, "cta_url"),
					})
				</div>
				@form.Form(form.FormArgs{
					ID:    fmt.Sprintf("block-form-%d", block.ID),
					Class: "space-y-2",
					Attributes: map[string]any{
						"enctype": "multipart/form-data",
					},
				}) {
					@imageupload.ImageUpload(imageupload.ImageUploadArgs{
						SignalName: pfx + "background_image",
						UploadURL:  "/admin/pages/blocks/upload-image",
						FormID:     fmt.Sprintf("block-form-%d", block.ID),
						Label:      "Background Image",
						ID:         fmt.Sprintf("bg-image-%d", block.ID),
						Hint:       "Recommended: 1920x1080px, JPG or PNG",
					})
				}
				<div class="space-y-1.5">
					{{
						overlayAttrs := bindAttr(pfx, "overlay_opacity")
						overlayAttrs["min"] = "0"
						overlayAttrs["max"] = "0.9"
						overlayAttrs["step"] = "0.05"
						overlayAttrs["inputmode"] = "decimal"
					}}
					@label.Label(label.LabelArgs{}) {
						Overlay Opacity (0-0.9)
					}
					@input.Input(input.InputArgs{
						Type: "number", Placeholder: "0.5",
						Class: "w-full", Attributes: overlayAttrs,
					})
				</div>
			</div>
		case "cta":
			<div class="space-y-3">
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						Headline
					}
					@input.Input(input.InputArgs{
						Type: "text", Placeholder: "Enter headline…",
						Class: "w-full", Attributes: bindAttr(pfx, "headline"),
					})
				</div>
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						Description
					}
					@textarea.Textarea(textarea.TextareaArgs{
						Placeholder: "Enter description…",
						Class:       "w-full",
						Attributes:  bindAttr(pfx, "description"),
					})
				</div>
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						Button Text
					}
					@input.Input(input.InputArgs{
						Type: "text", Placeholder: "e.g. Get Started",
						Class: "w-full", Attributes: bindAttr(pfx, "button_text"),
					})
				</div>
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						Button URL
					}
					@input.Input(input.InputArgs{
						Type: "text", Placeholder: "/signup",
						Class: "w-full", Attributes: bindAttr(pfx, "button_url"),
					})
				</div>
			</div>
		case "features":
			@featuresEditor(pageID, block, pfx)
		case "episodes_showcase":
			@episodesShowcaseEditor(block, pfx)
		case "testimonials":
			@testimonialsEditor(pageID, block, pfx)
		case "footer":
			@footerEditor(pageID, block, pfx)
		case "prose":
			<div class="space-y-3">
				<div class="space-y-1.5">
					@label.Label(label.LabelArgs{}) {
						Content (Markdown)
					}
					@textarea.Textarea(textarea.TextareaArgs{
						Placeholder: "Write your content in markdown…",
						Class:       "w-full min-h-48",
						Attributes:  bindAttr(pfx, "body"),
					})
				</div>
			</div>
	}
}

templ featuresEditor(pageID int64, block *domain.PageBlock, pfx string) {
	{{ content := parseBlockContent(block) }}
	{{ items := toItems(content["items"]) }}
	<div class="space-y-3">
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Section Title
			}
			@input.Input(input.InputArgs{
				Type: "text", Placeholder: "Enter section title…",
				Class: "w-full", Attributes: bindAttr(pfx, "section_title"),
			})
		</div>
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Section Description
			}
			@textarea.Textarea(textarea.TextareaArgs{
				Placeholder: "Enter description…",
				Class:       "w-full",
				Attributes:  bindAttr(pfx, "section_description"),
			})
		</div>
		<div class="space-y-2">
			<div class="flex items-center justify-between">
				@label.Label(label.LabelArgs{}) {
					Features
				}
				@button.Button(button.ButtonArgs{
					Variant: "outline", Size: "sm", Type: "button",
					Attributes: map[string]any{
						"data-on:click": fmt.Sprintf("@post('/admin/pages/%d/blocks/%d/items?type=feature')", pageID, block.ID),
					},
				}) {
					@icon.Lucide("plus", "size-4 mr-1")
					Add Feature
				}
			</div>
			<div id={ fmt.Sprintf("block-%d-features", block.ID) } class="space-y-2">
				for i, item := range items {
					@featureItemEditor(pageID, block.ID, pfx, i, item)
				}
			</div>
		</div>
	</div>
}

templ featureItemEditor(pageID int64, blockID int64, pfx string, index int, item map[string]any) {
	<div class="border rounded-lg p-3 space-y-2">
		<div class="flex items-center justify-between">
			<span class="text-xs font-medium text-muted-foreground">Feature { fmt.Sprintf("%d", index+1) }</span>
			@button.Button(button.ButtonArgs{
				Variant: "ghost", Size: "icon", Type: "button",
				Attributes: map[string]any{
					"data-on:click": fmt.Sprintf("@delete('/admin/pages/%d/blocks/%d/items/%d?type=feature')", pageID, blockID, index),
				},
			}) {
				@icon.Lucide("trash-2", "size-4 text-muted-foreground")
			}
		</div>
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Icon name (e.g. mic, headphones)",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("item_%d_icon", index)),
		})
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Feature title",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("item_%d_title", index)),
		})
		@input.Input(input.InputArgs{
			Type: "text", Placeholder: "Feature description",
			Class: "w-full", Attributes: bindAttr(pfx, fmt.Sprintf("item_%d_description", index)),
		})
	</div>
}

templ episodesShowcaseEditor(block *domain.PageBlock, pfx string) {
	<div class="space-y-3">
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Section Title
			}
			@input.Input(input.InputArgs{
				Type: "text", Placeholder: "Enter section title…",
				Class: "w-full", Attributes: bindAttr(pfx, "section_title"),
			})
		</div>
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Section Description
			}
			@textarea.Textarea(textarea.TextareaArgs{
				Placeholder: "Enter description…",
				Class:       "w-full",
				Attributes:  bindAttr(pfx, "section_description"),
			})
		</div>
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Max Episodes
			}
			@input.Input(input.InputArgs{
				Type: "number", Placeholder: "6",
				Class: "w-full", Attributes: bindAttr(pfx, "max_episodes"),
			})
		</div>
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Display Mode
			}
			@selectcomponent.Select(selectcomponent.SelectArgs{
				ID:           pfx + "display_mode_select",
				DefaultValue: displayModeVal(block),
				Options: []selectcomponent.SelectOptionArgs{
					{Value: "grid", Label: "Grid"},
					{Value: "list", Label: "List"},
				},
				Class:    "w-full",
				OnChange: fmt.Sprintf("$%sdisplay_mode = $%sdisplay_mode_select.value", pfx, pfx),
			})
		</div>
	</div>
}

templ testimonialsEditor(pageID int64, block *domain.PageBlock, pfx string) {
	{{ content := parseBlockContent(block) }}
	{{ items := toItems(content["items"]) }}
	<div class="space-y-3">
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Section Title
			}
			@input.Input(input.InputArgs{
				Type: "text", Placeholder: "Enter section title…",
				Class: "w-full", Attributes: bindAttr(pfx, "section_title"),
			})
		</div>
		<div class="space-y-1.5">
			@label.Label(label.LabelArgs{}) {
				Section Description
			}
			@textarea.Textarea(textarea.TextareaArgs{
				Placeholder: "Enter description…",
				Class:       "w-full",
				Attributes:  bindAttr(pfx, "section_description"),
			})
		</div>
		<div class="space-y-2">
			<div class="flex items-center justify-between">
				@label.Label(label.LabelArgs{}) {
					Testimonials
				}
				@button.Button(button.ButtonArgs{
					Variant: "outline", Size: "sm", Type: "button",
					Attributes: map[string]any{
						"data-on:click": fmt.Sprintf("@post('/admin/pages/%d/blocks/%d/items?type=testimonial')", pageID, block.ID),
