package pageform
import "github.com/gracchi-stdio/castogo/internal/domain"
import "github.com/gracchi-stdio/castogo/internal/view/layout"
import "github.com/gracchi-stdio/castogo/internal/view/components/tabs"
import "github.com/gracchi-stdio/castogo/internal/view/components/button"
import "github.com/gracchi-stdio/castogo/internal/view/components/icon"
import "github.com/gracchi-stdio/castogo/internal/view/editors/blockeditor"
import "github.com/gracchi-stdio/castogo/internal/view/components/card"
import "github.com/gracchi-stdio/castogo/internal/view/components/formactions"

templ Edit(shared *domain.AdminSharedData, args Args) {
  @layout.AdminLayout("Edit Page", shared, editPageActions(), nil) {
    @tabs.Tabs(tabs.TabsArgs{ID: "page_tabs", DefaultValue: args.DefaultTab}) {
      @tabs.TabsList(tabs.TabsListArgs{}) {
        @tabs.TabsTrigger(tabs.TabsTriggerArgs{ID: "page_tabs", Value: "settings"}) {
          Page Settings
        }
        @tabs.TabsTrigger(tabs.TabsTriggerArgs{ID: "page_tabs", Value: "blocks"}) {
          Blocks
        }
      }
      @tabs.TabsContent(tabs.TabsContentArgs{ID: "page_tabs", Value: "settings"}) {
        @card.Card(card.CardArgs{Class: "w-full max-w-md"}) {
          @card.CardContent(card.CardContentArgs{}) {
            @Settings(args)
          }
        }
      }
      @tabs.TabsContent(tabs.TabsContentArgs{ID: "page_tabs", Value: "blocks"}) {
        @blockEditor.BlockEditor(args.Page.ID, args.Blocks)
      }
    }
    <div class="sticky bottom-0 bg-background95 backdrop-blur border-t py-3 px-4 -mx-4 -mb-4">
      <div class="flex justify-end gap-2">
        @formactions.FormActions(formactions.FormActionsArgs{
		FormID: "page-settings-form",
		SubmitLabel: "Save Changes",
		CancelHref: "admin/pages"})
      </div>
    </div>
  }
}

templ editPageActions() {
  <a href="/admin/pages">@button.Button(button.ButtonArgs{
	Variant: "outline",
	Size: "sm",
	}) {
      @icon.Lucide("arrow-left", "size-4 mr-1")
      Back to Pages
    }</a>
}
