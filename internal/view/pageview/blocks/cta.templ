package blocks

import (
	"fmt"

	"github.com/gracchi-stdio/castogo/internal/domain"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
)

templ CtaBlock(content *domain.CTAContent) {
	<section class="py-20" aria-labelledby="cta-heading">
		<div class="mx-auto max-w-4xl px-6">
			<div class="border border-primary bg-background p-12 text-center">
				if content.Headline != "" {
					<h2 id="cta-heading" class="text-3xl font-bold text-foreground font-heading balance">{ content.Headline }</h2>
				}
				if content.Description != "" {
					<p class="mt-4 text-lg text-muted-foreground max-w-xl mx-auto pretty">{ content.Description }</p>
				}
				if content.ButtonText != "" {
					<div class="mt-8">
						@button.Button(button.ButtonArgs{
							Size:  "lg",
							Class: "text-base px-8",
							Attributes: map[string]any{
								"onclick": fmt.Sprintf("window.location.href='%s'", content.ButtonURL),
							},
						}) {
							{ content.ButtonText }
						}
					</div>
				}
			</div>
		</div>
	</section>
}
