package blocks

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/gracchi-stdio/castogo/internal/domain"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
)

templ HeroBlock(content *domain.HeroContent) {
	{{
		bg := strings.Trim(content.BackgroundImage, "'\"")
		overlay := strings.Trim(content.OverlayOpacity, "'\"")
		overlayOpacity := 0.5
		if overlay != "" {
			if v, err := strconv.ParseFloat(overlay, 64); err == nil {
				if v < 0 {
					v = 0
				}
				if v > 0.9 {
					v = 0.9
				}
				overlayOpacity = v
			}
		}
	}}
	<section class="relative overflow-hidden border-b-2 border-border">
		if bg != "" {
			<div class="absolute inset-0 bg-cover bg-center" style={ fmt.Sprintf("background-image: url(%s)", bg) }>
				<div class="absolute inset-0 bg-white dark:bg-black" style={ fmt.Sprintf("opacity: %.2f", overlayOpacity) }></div>
			</div>
		}
		<div class={ "relative mx-auto max-w-4xl px-6 py-24 text-center", ternary(bg == "", "bg-background", "") }>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground font-heading">
				{ content.Headline }
			</h1>
			if content.Subheadline != "" {
				<p class="mt-6 text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto">
					{ content.Subheadline }
				</p>
			}
			if content.CTAText != "" {
				<div class="mt-10">
					@button.Button(button.ButtonArgs{
						Size:  "lg",
						Class: "text-base px-8",
						Attributes: map[string]any{
							"onclick": fmt.Sprintf("window.location.href='%s'", content.CTAURL),
						},
					}) {
						{ content.CTAText }
					}
				</div>
			}
		</div>
	</section>
}
