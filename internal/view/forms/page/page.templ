package pageform

import "github.com/gracchi-stdio/castogo/internal/domain"
import "github.com/gracchi-stdio/castogo/internal/view/layout"
import "github.com/gracchi-stdio/castogo/internal/view/components/tabs"
import "github.com/gracchi-stdio/castogo/internal/view/components/button"
import "github.com/gracchi-stdio/castogo/internal/view/components/icon"
import "github.com/gracchi-stdio/castogo/internal/view/components/blockeditor"

templ Page(shared *domain.AdminSharedData, args Args) {
	{{
		title := "New Page"
		if args.Page != nil {
			title = "Edit Page"
		}
	}}
	@layout.AdminLayout(title, shared, pageActions(), nil) {
		if args.Page != nil {
			@tabs.Tabs(tabs.TabsArgs{ID: "page_tabs", DefaultValue: args.DefaultTab}) {
				@tabs.TabsList(tabs.TabsListArgs{}) {
					@tabs.TabsTrigger(tabs.TabsTriggerArgs{ID: "page_tabs", Value: "settings"})
					@tabs.TabsTrigger(tabs.TabsTriggerArgs{ID: "page_tabs", Value: "blocks"})
				}
				@tabs.TabsContent(tabs.TabsContentArgs{ID: "page_tabs", Value: "settings"}) {
					@Settings(args)
				}
				@tabs.TabsContent(tabs.TabsContentArgs{ID: "page_tabs", Value: "blocks"}) {
					@blockeditor.BlockEditor(args.Page.ID, args.Blocks)
				}
			}
		} else {
			@Settings(args)
		}
	}
}

templ pageActions() {
	<a href="/admin/pages">
		@button.Button(button.ButtonArgs{
			Variant: "outline",
			Size:    "sm",
		}) {
			@icon.Lucide("arrow-left", "size-4 mr-1")
			Back to Pages
		}
	</a>
}
