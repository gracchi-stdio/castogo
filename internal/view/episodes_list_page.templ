package view

import (
	"github.com/gracchi-stdio/castogo/internal/domain"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
	"github.com/gracchi-stdio/castogo/internal/view/components/card"
)

templ EpisodesListPage(shared *domain.AdminSharedData) {
	@AdminLayout("Episodes", shared, episodesListActions()) {
		@card.Card(card.CardArgs{}) {
			@card.CardContent(card.CardContentArgs{Class: "flex flex-col items-center gap-4 py-8"}) {
				@Icon("headphones", "size-12 text-muted-foreground/30")
				<p class="text-muted-foreground">No episodes yet. Create your first episode to get started.</p>
				@button.Button(button.ButtonArgs{Variant: "default"}) {
					@Icon("circle-plus", "size-4 mr-1")
					New Episode
				}
			}
		}
	}
}

templ episodesListActions() {
	@button.Button(button.ButtonArgs{Variant: "default", Size: "sm"}) {
		@Icon("circle-plus", "size-4 mr-1")
		New Episode
	}
}
