package authview

import (
	"github.com/gracchi-stdio/castogo/internal/config"
	"github.com/gracchi-stdio/castogo/internal/view/components/brand"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
	"github.com/gracchi-stdio/castogo/internal/view/components/card"
	"github.com/gracchi-stdio/castogo/internal/view/components/form"
	"github.com/gracchi-stdio/castogo/internal/view/components/input"
	"github.com/gracchi-stdio/castogo/internal/view/components/label"
	"github.com/gracchi-stdio/castogo/internal/view/layout"
)

templ LoginPage() {
	@layout.BaseLayout("") {
		<main class="min-h-screen grid sm:grid-cols-2 grid-cols-1 place-items-center p-4 gap-4">
			<div class="flex justify-center items-center flex-wrap gap-4">
				@brand.Mascot("size-42")
				<h1 class="text-5xl font-bold">{ config.Cfg.AppName }</h1>
			</div>
			<div class="w-full max-w-sm" data-signals:email="''" data-signals:password="''" data-signals:error="''" data-signals:email_error="''" data-signals:password_error="''">
				<div
					data-show="$error != ''"
					data-text="$error"
					class="text-destructive bg-destructive/15 border border-destructive p-3 rounded-md mb-4"
				></div>
				@form.Form(form.FormArgs{
					Action:      "/login",
					ContentType: "json",
					Class:       "w-full max-w-sm",
				}) {
					@card.Card(card.CardArgs{}) {
						@card.CardHeader(card.CardHeaderArgs{Class: "text-center"}) {
							@card.CardTitle(card.CardTitleArgs{}) {
								<h2 class="text-xl font-bold">
									Sign In
								</h2>
							}
						}
						@card.CardContent(card.CardContentArgs{}) {
							<div class="space-y-4">
								<div class="space-y-2">
									@label.Label(label.LabelArgs{For: "email"}) {
										Email
									}
									@input.Input(input.InputArgs{
										Type:  "email",
										ID:    "email",
										Name:  "email",
										Class: "w-full",
										Attributes: map[string]any{
											"data-on:input": "$email = el.value; $email_error = ''",
										},
									})
									<p
										data-show="$email_error != ''"
										data-text="$email_error"
										class="text-sm text-destructive"
									></p>
								</div>
								<div class="space-y-2">
									@label.Label(label.LabelArgs{For: "password"}) {
										Password
									}
									@input.Input(input.InputArgs{
										Type:  "password",
										ID:    "password",
										Name:  "password",
										Class: "w-full",
										Attributes: map[string]any{
											"data-on:input": "$password = el.value; $password_error = ''",
										},
									})
									<p
										data-show="$password_error != ''"
										data-text="$password_error"
										class="text-sm text-destructive"
									></p>
								</div>
								@button.Button(button.ButtonArgs{
									Type:  "submit",
									Class: "w-full",
								}) {
									Sign In
								}
							</div>
						}
					}
				}
			</div>
		</main>
	}
}
