package view

import (
	"github.com/gracchi-stdio/castogo/internal/domain"
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
	"github.com/gracchi-stdio/castogo/internal/view/components/card"
	"github.com/gracchi-stdio/castogo/internal/view/components/input"
	"github.com/gracchi-stdio/castogo/internal/view/components/label"
	"github.com/gracchi-stdio/castogo/internal/view/components/textarea"
)

templ EpisodeNewPage(shared *domain.AdminSharedData) {
	@AdminLayout("New Episode", shared, episodeNewActions()) {
		<div
			data-signals:title="''"
			data-signals:description="''"
			data-signals:uploading="false"
			data-signals:uploading_status="''"
			data-signals:error="''"
			data-signals:title_error="''"
			data-signals:description_error="''"
			data-signals:audio_file_error="''"
			data-signals:audio_duration="''"
			data-signals:audio_sample_rate="'--'"
			data-signals:audio_channel_count="'--'"
			data-signals:audio_bitrate="'--'"
			data-signals:audio_format="'--'"
			data-signals:audio_mime_type="'--'"
			data-signals:audio_file_size="'--'"
			data-signals:metadata_extracted="false"
		>
			<!-- General error banner -->
			<div
				data-show="$error != ''"
				data-text="$error"
				class="text-destructive bg-destructive/15 border border-destructive p-3 rounded-md mb-4"
			></div>
			<!-- Loading overlay -->
			<div data-show="$uploading" class="fixed inset-0 bg-background/50 backdrop-blur-sm z-50 flex items-center justify-center">
				<div class="flex items-center gap-3 bg-card border rounded-lg px-6 py-4 shadow-lg">
					<svg class="animate-spin size-5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
					<span class="text-sm font-medium" data-text="$uploading_status"></span>
				</div>
			</div>
			<form enctype="multipart/form-data" id="episode-form">
				@card.Card(card.CardArgs{}) {
					@card.CardContent(card.CardContentArgs{}) {
						<div class="space-y-4">
							<!-- Title -->
							<div class="space-y-2">
								@label.Label(label.LabelArgs{For: "title"}) {
									Title
								}
								@input.Input(input.InputArgs{
									Type:        "text",
									ID:          "title",
									Name:        "title",
									Placeholder: "My Awesome Episode",
									Class:       "w-full",
									Attributes: map[string]any{
										"data-on:input": "$title = el.value; $title_error = ''",
									},
								})
								<p
									data-show="$title_error != ''"
									data-text="$title_error"
									class="text-sm text-destructive"
								></p>
							</div>
							<!-- Description -->
							<div class="space-y-2">
								@label.Label(label.LabelArgs{For: "description"}) {
									Description
								}
								@textarea.Textarea(textarea.TextareaArgs{
									ID:          "description",
									Name:        "description",
									Placeholder: "What's this episode about?",
									Class:       "w-full",
									Rows:        4,
									Attributes: map[string]any{
										"data-on:input": "$description = el.value; $description_error = ''",
									},
								})
								<p
									data-show="$description_error != ''"
									data-text="$description_error"
									class="text-sm text-destructive"
								></p>
							</div>
							<!-- Audio File -->
							<div class="space-y-2">
								@label.Label(label.LabelArgs{For: "audio_file"}) {
									Audio File
								}
								<input
									type="file"
									id="audio_file"
									name="audio_file"
									accept="audio/*"
									data-on:change="$audio_file_error = ''; window.extractAudioMetadata(el)"
									class="flex w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm file:border-0 file:bg-primary file:text-primary-foreground file:hover:bg-primary/90 file:mr-4 file:py-0.5 file:px-3 file:rounded-md file:text-sm file:font-medium file:cursor-pointer"
								/>
								<p
									data-show="$audio_file_error != ''"
									data-text="$audio_file_error"
									class="text-sm text-destructive"
								></p>
							</div>
							<!-- Audio Metadata -->
							<input type="hidden" name="duration" id="metadata_duration" value="0"/>
							<input type="hidden" name="sample_rate" id="metadata_sample_rate" value="0"/>
							<input type="hidden" name="channel_count" id="metadata_channel_count" value="0"/>
							<input type="hidden" name="bitrate" id="metadata_bitrate" value="0"/>
							<input type="hidden" name="file_size" id="metadata_file_size" value="0"/>
							<input type="hidden" name="format" id="metadata_format" value=""/>
							<input type="hidden" name="mimeType" id="metadata_mime_type" value=""/>
							<!-- Audio Metadata Preview -->
							<div data-show="$metadata_extracted" class="mt-4 p-4 rounded-md border bg-muted/50">
								<h4 class="text-sm font-medium mb-2">Audio Metadata</h4>
								<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
									<div>
										<span class="text-muted-foreground">Duration</span>
										<p class="font-medium" data-text="$audio_duration"></p>
									</div>
									<div>
										<span class="text-muted-foreground">Sample Rate</span>
										<p class="font-medium" data-text="$audio_sample_rate"></p>
									</div>
									<div>
										<span class="text-muted-foreground">Channels</span>
										<p class="font-medium" data-text="$audio_channel_count"></p>
									</div>
									<div>
										<span class="text-muted-foreground">Bitrate</span>
										<p class="font-medium" data-text="$audio_bitrate"></p>
									</div>
									<div>
										<span class="text-muted-foreground">Format</span>
										<p class="font-medium" data-text="$audio_format"></p>
									</div>
									<div>
										<span class="text-muted-foreground">MIME Type</span>
										<p class="font-medium" data-text="$audio_mime_type"></p>
									</div>
									<div>
										<span class="text-muted-foreground">File Size</span>
										<p class="font-medium" data-text="$audio_file_size"></p>
									</div>
								</div>
							</div>
							<!-- Submit -->
							<div class="flex justify-end">
								@button.Button(button.ButtonArgs{
									Type: "button",
									Attributes: map[string]any{
										"data-on:click": "$uploading_status = 'Starting upload...'; $uploading = true; @post('/admin/episodes/create', {contentType: 'form', form: '#episode-form'})",
									},
								}) {
									Create Episode
								}
							</div>
						</div>
					}
				}
			</form>
		</div>
	}
}

templ episodeNewActions() {
	<a href="/admin/episodes">
		@button.Button(button.ButtonArgs{Variant: "outline", Size: "sm"}) {
			@Icon("arrow-left", "size-4 mr-1")
			Back to Episodes
		}
	</a>
}
