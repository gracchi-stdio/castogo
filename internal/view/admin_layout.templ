package view

import (
	"github.com/gracchi-stdio/castogo/internal/config"
	"github.com/gracchi-stdio/castogo/internal/domain"
)

templ SidebarNav() {
	<sl-menu class="sidebar-menu">
		<sl-menu-label>General</sl-menu-label>
		<sl-menu-item data-on:click="window.location.href = '/admin'">
			<sl-icon slot="prefix" name="grid"></sl-icon>
			Dashboard
		</sl-menu-item>
		<sl-menu-label>Podcast</sl-menu-label>
		<sl-menu-item data-on:click="window.location.href = '/admin/episodes'">
			<sl-icon slot="prefix" name="list-ul"></sl-icon>
			All Episodes
		</sl-menu-item>
		<sl-menu-item data-on:click="window.location.href = '/admin/episodes/new'">
			<sl-icon slot="prefix" name="plus-circle"></sl-icon>
			New Episode
		</sl-menu-item>
		<sl-divider></sl-divider>
		<sl-menu-label>System</sl-menu-label>
		<sl-menu-item data-on:click="window.location.href = '/admin/settings'">
			<sl-icon slot="prefix" name="gear"></sl-icon>
			Settings
		</sl-menu-item>
	</sl-menu>
}

templ AdminLayout(title string, shared *domain.AdminSharedData, actions templ.Component) {
	@BaseLayout() {
		<!-- Mobile drawer sidebar -->
		<sl-drawer id="admin-drawer" class="admin-drawer" placement="start" label={ config.Cfg.AppName }>
			@SidebarNav()
		</sl-drawer>

		<!-- Admin layout container -->
		<div class="admin-layout">
			<!-- Desktop sidebar (hidden on mobile via CSS) -->
			<aside class="admin-sidebar">
				<div class="sidebar-header">
					<span class="sidebar-brand">{ config.Cfg.AppName }</span>
					<img src="/logo.svg" alt="Logo" class="sidebar-logo">
				</div>
				@SidebarNav()
			</aside>

			<!-- Main area -->
			<div class="admin-main">
				<header class="admin-topbar">
					<sl-icon-button class="admin-hamburger" name="list" label="Menu"
						data-on:click="document.getElementById('admin-drawer').show()">
					</sl-icon-button>
					<h2 class="topbar-title">{ title }</h2>
					<div class="topbar-actions">
						if actions != nil {
							@actions
						}
						<sl-dropdown placement="bottom-end" distance="8">
							<sl-avatar slot="trigger" initials={shared.User.Email[0:2]} label={ shared.User.Email } style="--size: 2rem; cursor: pointer"></sl-avatar>
							<sl-menu>
								<sl-menu-item disabled>
									<sl-icon slot="prefix" name="person"></sl-icon>
									{ shared.User.Email }
								</sl-menu-item>
								<sl-divider></sl-divider>
								<sl-menu-item data-on:click="@post('/logout')">
									<sl-icon slot="prefix" name="box-arrow-right"></sl-icon>
									Sign Out
								</sl-menu-item>
							</sl-menu>
						</sl-dropdown>
					</div>
				</header>
				<main class="admin-content">
					{ children... }
				</main>
			</div>
		</div>
	}
}
