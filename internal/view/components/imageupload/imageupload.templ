package imageupload

import (
	"github.com/gracchi-stdio/castogo/internal/view/components/button"
	"github.com/gracchi-stdio/castogo/internal/view/components/icon"
	"github.com/gracchi-stdio/castogo/internal/view/components/label"
)

templ ImageUpload(args ImageUploadArgs) {
	{{ accept := args.Accept }}
	{{
		if accept == "" {
			accept = "image/jpeg,image/png,image/webp"
		}
	}}
	{{
		uploadExpression := "@post('" + args.UploadURL + "', {contentType: 'form', form: '#" + args.FormID + "'})"
		if args.UploadingSignal != "" {
			uploadExpression = "$" + args.UploadingSignal + " = true; " + uploadExpression
			if args.StatusSignal != "" {
				uploadExpression = "$" + args.StatusSignal + " = 'Uploading image...'; " + uploadExpression
			}
		}
	}}
	{{ bindAttrs := templ.Attributes{"data-bind:" + args.SignalName: ""} }}
	<div class={ args.Class } { args.Attributes... }>
		if args.Horizontal {
			<div class="grid gap-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
				<div class="min-w-0 space-y-3">
					@label.Label(label.LabelArgs{For: args.ID}) { { args.Label } }
					<input type="hidden" data-slot="image-url-input" { bindAttrs... }/>
					<div data-show={ "$" + args.SignalName + " === ''" } class={ imageUploadDropZone("min-h-28") } data-on:click={ "document.getElementById('" + args.ID + "').click()" }>
						<div class="flex items-center gap-3 text-muted-foreground">
							@icon.Lucide("image-plus", "size-6")
							<div>
								<p class="text-sm font-medium">Click to upload</p>
								if args.Hint != "" {
									<p class="text-xs">{ args.Hint }</p>
								}
							</div>
						</div>
					</div>
					<div data-show={ "$" + args.SignalName + " !== ''" } class="flex flex-wrap items-center gap-2">
						@button.Button(button.ButtonArgs{Type: "button", Variant: "outline", Size: "sm", Attributes: templ.Attributes{"data-on:click": "document.getElementById('" + args.ID + "').click()"}}) {
							@icon.Lucide("refresh-cw", "size-4")
							Change image
						}
						if args.Clearable {
							@button.Button(button.ButtonArgs{Type: "button", Variant: "ghost", Size: "sm", Attributes: templ.Attributes{"data-on:click": "$" + args.SignalName + " = ''"}}) {
								@icon.Lucide("x", "size-4")
								Remove
							}
						}
					</div>
				</div>
				<div data-show={ "$" + args.SignalName + " !== ''" }>
					<img data-attr:src={ "$" + args.SignalName } alt="Image preview" class={ imageUploadPreview(args.PreviewW, args.PreviewH) }/>
				</div>
			</div>
		} else {
			@label.Label(label.LabelArgs{For: args.ID}) { { args.Label } }
			<input type="hidden" data-slot="image-url-input" { bindAttrs... }/>
			<!-- Empty state: dashed upload area -->
			<div data-show={ "$" + args.SignalName + " === ''" } class={ imageUploadDropZone("") } data-on:click={ "document.getElementById('" + args.ID + "').click()" }>
				<div class="flex flex-col items-center gap-2 text-muted-foreground">
					@icon.Lucide("image-plus", "size-8")
					<p class="text-sm font-medium">Click to upload</p>
					if args.Hint != "" {
						<p class="text-xs">{ args.Hint }</p>
					}
				</div>
			</div>
			<!-- Has image: preview -->
			<div data-show={ "$" + args.SignalName + " !== ''" } class="space-y-2">
				<button type="button" class="block cursor-pointer" data-on:click={ "document.getElementById('" + args.ID + "').click()" }>
					<img data-attr:src={ "$" + args.SignalName } alt="Image preview" class={ imageUploadPreview(args.PreviewW, args.PreviewH) }/>
				</button>
				<p class="text-xs text-muted-foreground">Click image to change</p>
			</div>
		}
		<!-- Hidden file input -->
		<input
			type="file"
			id={ args.ID }
			name="image_file"
			accept={ accept }
			class="hidden"
			if args.FormID != "" {
				form={ args.FormID }
			}
			data-on:change={ uploadExpression }
		/>
		<input
			type="hidden"
			name="signal_name"
			value={ args.SignalName }
			if args.FormID != "" {
				form={ args.FormID }
			}
		/>
	</div>
}
