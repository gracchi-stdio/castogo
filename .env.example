# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
# On a second dev machine this file is the checklist of what to configure.

# --- Core ---
# Local dev database (podman compose publishes localhost:5432)
DATABASE_URL=postgres://castogo:castogo@localhost:5432/castogo?sslmode=disable
# 32+ random chars; signs session cookies
SESSION_SECRET=dev-secret-change-me-32-chars-minimum
PORT=8080
# development | production — production loads Vite assets from the manifest
ENV=development
SITE_URL=http://localhost:8080
APP_NAME=Castogo
# Allow self-service signup at /register (admin users can also be created
# with: just cli register --email ... --generate)
REGISTRATION_ENABLED=false
# Run FFmpeg loudness normalization on upload (requires ffmpeg on PATH)
AUDIO_PROCESSING_ENABLED=true

# --- Bunny CDN / storage ---
BUNNY_STORAGE_ENDPOINT=
BUNNY_STORAGE_PASSWORD=
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
STORAGE_CDN=

# --- Not read by the app; used by `just cli-prod` to run castogo-cli
# commands against the production database (e.g. the Aiven service URI).
REMOTE_DATABASE_URL=
