{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "allowJs": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "*.ts", "**/*.ts", "vite-env.d.ts", "assets/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
